# Dev default: zero-setup SQLite file. For production, switch the datasource
# provider in prisma/schema.prisma to "mysql" (or "postgresql") and point this
# at your real database, e.g.:
#   DATABASE_URL="mysql://user:password@host:3306/huska"
DATABASE_URL="file:./dev.db"

# Long random string in production
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

PORT=4000
CORS_ORIGIN="https://hgtams.up.railway.app"

# Optional: seed script uses these to create the very first admin account
SEED_ADMIN_NAME="Huska Admin"
SEED_ADMIN_EMAIL="admin@huska.app"
SEED_ADMIN_PASSWORD="Admin@12345"

# Optional: seed script also creates a starter attendance zone using these
SEED_ZONE_NAME="Huska Lab"
SEED_ZONE_LAT="-1.9441"
SEED_ZONE_LNG="30.0619"
SEED_ZONE_RADIUS_M="150"
